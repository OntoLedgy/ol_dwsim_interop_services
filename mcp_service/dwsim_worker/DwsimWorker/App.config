<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <appSettings>
    <!-- DWSIM Assembly Path Configuration -->
    <!-- Path to DWSIM Debug build assemblies for development/testing -->
    <add key="DwsimPath" value="D:\S\C#\dwsim\DWSIM\bin\Debug" />

    <!-- Named Pipe configuration -->
    <add key="PipeName" value="dwsim_worker_pipe" />
    <add key="MaxConcurrentConnections" value="5" />

    <!-- Session configuration -->
    <add key="MaxSessions" value="10" />
    <add key="SessionTimeoutMinutes" value="60" />

    <!-- Resource limits -->
    <add key="MaxMemoryMB" value="4096" />
    <add key="OperationTimeoutSeconds" value="300" />

    <!-- Logging -->
    <add key="LogLevel" value="Information" />
    <add key="LogDirectory" value="logs" />
  </appSettings>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- Binding redirect for Newtonsoft.Json to resolve version conflicts with DWSIM -->
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.3.0" newVersion="13.0.0.0" />
      </dependentAssembly>

      <!-- Additional binding redirects for DWSIM assemblies can be added here as needed -->
    </assemblyBinding>
  </runtime>
</configuration>
