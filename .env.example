# DWSIM MCP Server configuration template.
# Render this Jinja2 template to produce a .env file.

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
# Logging level for the MCP server (e.g., DEBUG, INFO, WARNING).
DWSIM_LOG_LEVEL=INFO
# Enable pythonnet bridge for in-process worker calls.
DWSIM_ENABLE_PYTHONNET=true
# Optional path to DwsimWorker.dll if not using default discovery.
DWSIM_WORKER_ASSEMBLY_PATH=

# ------------------------------------------------------------------------------
# Authentication (Clerk OAuth)
# ------------------------------------------------------------------------------
# Enable OAuth authentication for the MCP server (true/false).
DWSIM_AUTH_ENABLED=false
# Clerk issuer URL (e.g., https://<your-tenant>.clerk.accounts.dev).
CLERK_ISSUER_URL=
# Optional override for Clerk JWKS URL (defaults to <issuer>/.well-known/jwks.json).
CLERK_JWKS_URL=
# Clerk audience value configured for your application.
CLERK_AUDIENCE=
# Required OAuth scopes (comma-separated, e.g., "user,read:flowsheet").
CLERK_REQUIRED_SCOPES=

# ------------------------------------------------------------------------------
# Resources
# ------------------------------------------------------------------------------
# Allowed base directories for case save/load operations (comma-separated).
DWSIM_CASE_STORAGE_ROOTS=./cases
# Maximum size in KB for resource content responses.
DWSIM_MAX_RESOURCE_SIZE_KB=1024

# ------------------------------------------------------------------------------
# Paths
# ------------------------------------------------------------------------------
# Path to documentation resources directory.
DWSIM_DOCS_PATH=./docs/resources
# Path to sample cases metadata directory.
DWSIM_SAMPLE_CASES_PATH=./cases/samples

# ------------------------------------------------------------------------------
# Resource Limits
# ------------------------------------------------------------------------------
# Maximum number of concurrent sessions.
DWSIM_MAX_SESSIONS=10
# Default session lifetime in seconds.
DWSIM_SESSION_TIMEOUT=3600
# Default per-operation timeout in seconds.
DWSIM_OPERATION_TIMEOUT=300
# Process memory limit in MB before rejecting new operations.
DWSIM_MEMORY_LIMIT_MB=2048
# Interval in seconds for polling process memory usage.
DWSIM_MEMORY_POLL_INTERVAL_SECONDS=2.0
# Ratio of memory limit below which breach state clears.
DWSIM_MEMORY_RECOVERY_RATIO=0.9

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# Logging level for the MCP server (e.g., DEBUG, INFO, WARNING).
# Note: shared with the server log level setting above.
DWSIM_LOG_LEVEL=INFO
# Optional log file path for rotating file logging.
DWSIM_LOG_FILE=
# Maximum log file size in bytes before rotation.
DWSIM_LOG_FILE_MAX_BYTES=10485760
# Number of rotated log files to keep.
DWSIM_LOG_FILE_BACKUP_COUNT=5

# ------------------------------------------------------------------------------
# Seq
# ------------------------------------------------------------------------------
# Seq server URL for structured log shipping.
DWSIM_SEQ_URL=
# Seq API key for authenticated log shipping.
DWSIM_SEQ_API_KEY=

# ------------------------------------------------------------------------------
# Tracing
# ------------------------------------------------------------------------------
# Enable OpenTelemetry tracing.
DWSIM_TRACING_ENABLED=false
# Tracing exporter type (jaeger, zipkin, otlp, console, none).
DWSIM_TRACING_EXPORTER=none
# Tracing exporter endpoint URL.
DWSIM_TRACING_ENDPOINT=
# Tracing sampling rate from 0.0 to 1.0.
DWSIM_TRACING_SAMPLE_RATE=1.0

# ------------------------------------------------------------------------------
# Metrics
# ------------------------------------------------------------------------------
# Enable Prometheus metrics collection.
DWSIM_METRICS_ENABLED=true
# Metrics HTTP server port.
DWSIM_METRICS_PORT=9090
